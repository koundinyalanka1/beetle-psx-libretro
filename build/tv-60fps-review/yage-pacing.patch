--- /dev/null
+++ b/native/yage_frame_pacing.h
@@ -0,0 +1,22 @@
+#ifndef YAGE_FRAME_PACING_H
+#define YAGE_FRAME_PACING_H
+#include <stdint.h>
+
+static inline int64_t yage_frame_sleep_ns(int64_t target_ns, int64_t emu_accum_ns,
+        int64_t display_interval_ns, int64_t display_accum_ns,
+        int64_t work_ns, int gate_refused)
+{
+    int64_t next_emu_ns, next_display_ns;
+    /* A lifecycle operation owns the core: back off rather than spin. */
+    if (gate_refused) return target_ns;
+    if (work_ns < 0) work_ns = 0;
+    next_emu_ns = target_ns - emu_accum_ns - work_ns;
+    next_display_ns = display_interval_ns - display_accum_ns - work_ns;
+    /* An overdue emulation deadline is real work, so run the next iteration.
+     * An overdue display deadline alone cannot be serviced: presentation
+     * requires a newly emulated frame. Wait for that frame instead. */
+    if (next_emu_ns <= 0) return 0;
+    if (next_display_ns <= 0) return next_emu_ns;
+    return next_emu_ns < next_display_ns ? next_emu_ns : next_display_ns;
+}
+#endif
--- /dev/null
+++ b/native/test/test_frame_pacing.c
@@ -0,0 +1,24 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../yage_frame_pacing.h"
+
+#define MS(n) ((int64_t)(n) * 1000000)
+
+int main(void)
+{
+    /* Core/presentation time consumes the remaining frame budget. */
+    assert(yage_frame_sleep_ns(MS(17), 0, MS(17), 0, MS(9), 0) == MS(8));
+    assert(yage_frame_sleep_ns(MS(17), 0, MS(17), 0, MS(42), 0) == 0);
+    assert(yage_frame_sleep_ns(MS(17), MS(30), MS(17), 0, MS(42), 0) == 0);
+    /* Expired display tick cannot force a hot spin before emulation is due. */
+    assert(yage_frame_sleep_ns(MS(17), MS(5), MS(17), MS(20), MS(1), 0) == MS(11));
+    assert(yage_frame_sleep_ns(MS(17), 0, MS(17), MS(14), MS(1), 0) == MS(2));
+    /* Gate backoff remains intact even when emulation is overdue. */
+    assert(yage_frame_sleep_ns(MS(17), MS(50), MS(17), MS(50), MS(42), 1) == MS(17));
+    /* Same scheduling arithmetic for PAL and explicit speed changes. */
+    assert(yage_frame_sleep_ns(MS(20), 0, MS(17), 0, MS(10), 0) == MS(7));
+    assert(yage_frame_sleep_ns(MS(4), 0, MS(17), 0, MS(3), 0) == MS(1));
+    assert(yage_frame_sleep_ns(MS(68), MS(30), MS(17), MS(50), MS(2), 0) == MS(36));
+    puts("Frame pacing: completed work, overdue frames, display-only waits, gate backoff and speed changes passed");
+    return 0;
+}
